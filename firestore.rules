rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return hasProfile() && profile().role == 'admin';
    }
    function isApprovedCustomer() {
      return hasProfile() && profile().role == 'customer' && profile().status == 'approved';
    }
    function canShop() {
      return isAdmin() || isApprovedCustomer();
    }
    // A customer flagged "sensitive" on their customers/ record (Customers →
    // edit) must never be shown a storefront product photo tagged
    // "branded_for_customer_id" for a DIFFERENT customer — e.g. Sunlife must
    // never see a Manulife-branded case-study photo. get() inside a rule reads
    // the target document's raw data regardless of that document's own read
    // rule (same mechanism profile() already relies on for users/{uid}), so
    // this needs no new client-readable field on customers/.
    function viewerIsSensitive() {
      return hasProfile()
        && profile().get('customer_id', '') != ''
        && exists(/databases/$(database)/documents/customers/$(profile().get('customer_id', '')))
        && get(/databases/$(database)/documents/customers/$(profile().get('customer_id', ''))).data.get('sensitive', false) == true;
    }

    match /users/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      allow create: if request.auth.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.status == 'pending'
        && request.resource.data.ws_discount_pct == 0;
      // sensitive/erp_code/erp_code_shared are ADMIN-MIRRORED fields (see
      // domain/customer.js's mirrorToLinkedAccounts) — a customer must never
      // be able to set these on their own doc, since sensitive gates whether
      // they see a competitor's branded photos and erp_code/erp_code_shared
      // gate whether the portal order-history feature will hand them ANOTHER
      // customer's JES sales data (netlify/edge-functions/
      // customer-order-history.js trusts these fields straight off the
      // caller's own users/{uid} doc — it has no elevated Firestore access to
      // re-verify them, so the write-side lock IS the security boundary).
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.ws_discount_pct == resource.data.ws_discount_pct
            && request.resource.data.get('pricing_group', '') == resource.data.get('pricing_group', '')
            && request.resource.data.get('corp_markup_override', 0) == resource.data.get('corp_markup_override', 0)
            && request.resource.data.get('sensitive', false) == resource.data.get('sensitive', false)
            && request.resource.data.get('erp_code', '') == resource.data.get('erp_code', '')
            && request.resource.data.get('erp_code_shared', false) == resource.data.get('erp_code_shared', false));
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if canShop();
      allow write: if isAdmin();
      // Storefront product photos. Screened per-viewer against
      // branded_for_customer_id + the viewer's own "sensitive" flag — see
      // viewerIsSensitive() above. A blank/unset branded_for is generic and
      // always visible; nothing changes for the existing catalogue.
      match /images/{imageId} {
        allow read: if isAdmin()
          || (isApprovedCustomer()
              && (resource.data.get('branded_for_customer_id', '') == ''
                  || resource.data.get('branded_for_customer_id', '') == profile().get('customer_id', '')
                  || !viewerIsSensitive()));
        allow write: if isAdmin();
      }
      match /pricing_tiers/{tierId} {
        allow read: if canShop();
        allow write: if isAdmin();
      }
      match /customer_prices/{priceUid} {
        allow read: if request.auth.uid == priceUid || isAdmin();
        allow write: if isAdmin();
      }
      match /components/{componentId} {
        allow read, write: if isAdmin();
        match /images/{imageId} {
          allow read, write: if isAdmin();
        }
        match /supplier_quotes/{quoteId} {
          allow read, write: if isAdmin();
          match /attachments/{attachmentId} {
            allow read, write: if isAdmin();
          }
        }
      }
    }

    match /range_products/{rangeId} {
      allow read: if canShop();
      allow write: if isAdmin();
      match /{allPaths=**} {
        allow read: if canShop();
        allow write: if isAdmin();
      }
    }

    match /settings/{docId} {
      allow read: if canShop();
      allow write: if isAdmin();
    }

    match /favourites/{uid} {
      allow read, write: if request.auth.uid == uid || isAdmin();
    }

    match /enquiries/{eid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Customizer product templates — read for shoppers, admin writes.
    match /product_templates/{productId} {
      allow read: if canShop();
      allow write: if isAdmin();
    }

    // Customizer saved designs — a customer owns their own designs; admin sees all.
    match /customer_designs/{designId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
      match /catalogs/{catalogId} {
        allow read, write: if isAdmin();
      }
    }
    match /client_quotes/{quoteId} {
      allow read, write: if isAdmin();
      match /items/{itemId} {
        allow read, write: if isAdmin();
      }
    }

    // Supplier purchase orders — internal procurement records, admin only.
    match /purchase_orders/{poId} {
      allow read, write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
      match /enquiries/{enquiryId} {
        allow read, write: if isAdmin();
      }
      // Email ingestion (V8.1 spike) — raw thread envelopes pulled from the
      // live IMAP mailbox, matched to this customer. Admin-only, always —
      // this is real correspondence content, never customer-facing, unlike
      // Brand Gallery assets below (see PROJECT-PLAN.md's V8.1 entry §6:
      // "nothing leaks through portal or customer-facing routes").
      match /email_threads/{threadId} {
        allow read, write: if isAdmin();
      }
      // Brand Gallery assets (V7.21) — customer logos / brand images.
      // The privacy guarantee (Customer_Brand_Gallery_Spec.md §6): admins have
      // full access; a logged-in customer may read ONLY their own linked
      // customer's non-internal assets. A customer-facing list query MUST
      // constrain itself to non-internal visibility, or the read is rejected.
      match /assets/{assetId} {
        allow read: if isAdmin()
          || (signedIn()
              && profile().get('customer_id', '') == customerId
              && resource.data.visibility != 'internal_only');
        allow write: if isAdmin();
      }
    }

    // Marketing contacts — the cleaned Mailchimp list + WordPress signups.
    // Kept separate from customers; admin-only in the app. Public signups are
    // written server-side by the /api/subscribe edge function (service account,
    // which bypasses these rules), never by the browser.
    match /marketing_contacts/{contactId} {
      allow read, write: if isAdmin();
    }
    // Marketing campaigns — batched Resend sends to marketing_contacts
    // segments. Admin-only, same posture as marketing_contacts. Unsubscribes
    // are written server-side by the /api/unsubscribe edge function (service
    // account, bypasses these rules) directly onto marketing_contacts, not here.
    match /marketing_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }
    // Reusable campaign starting points, owner-saved from the Unlayer editor
    // (Campaigns.jsx's "Save current as template") — same admin-only posture.
    match /campaign_templates/{templateId} {
      allow read, write: if isAdmin();
    }
    // Daily Drafts re-engagement engine (V7.23) — AI-drafted outreach emails,
    // pending human review before send. Admin-only, same posture as the other
    // marketing collections; both the browser (create/skip) and the admin's
    // own token via the generate/send edge functions read and write here.
    match /outreach_drafts/{draftId} {
      allow read, write: if isAdmin();
    }
    // Daily Drafts topic de-duplication (V8.0) — before targeting anyone
    // about a topic, DailyDrafts.jsx checks whether they already have a
    // logged Interaction Log entry for it, via a collectionGroup('enquiries')
    // query across every customer's own subcollection at once. The nested
    // `match /customers/{customerId} { match /enquiries/{enquiryId} {...} } }`
    // rule above does NOT authorize a collection-group query — Firestore
    // requires this separate top-level wildcard rule for that, same pattern
    // already used for supplier_quotes below. Read-only; writes still only
    // ever happen through the nested customers/{id}/enquiries path.
    match /{path=**}/enquiries/{enquiryId} {
      allow read: if isAdmin();
    }
    match /{path=**}/supplier_quotes/{quoteId} {
      allow read, write: if isAdmin();
    }
    match /catalogues/{catalogueId} {
      allow read, write: if isAdmin();
      match /items/{itemId} {
        allow read, write: if isAdmin();
      }
    }
    match /range_components/{componentId} {
      allow read, write: if isAdmin();
      match /supplier_quotes/{quoteId} {
        allow read, write: if isAdmin();
      }
      // Stock ledger (V7.13a) — append-only movement history behind on-hand.
      match /movements/{movementId} {
        allow read, write: if isAdmin();
      }
    }

    // Crystal inventory (V7.13a) — per-colour SKUs, admin only, with the same
    // append-only stock ledger.
    match /crystals/{crystalId} {
      allow read, write: if isAdmin();
      match /movements/{movementId} {
        allow read, write: if isAdmin();
      }
    }

    // Crystal Fabric Studio swatch notes (V7.22 §5a/§5b) — curated
    // legacy-Swarovski-ref metadata per crystal colour. Read opened to
    // approved portal customers in §5b (the whole point of the reference
    // list is a designer matching an old Swarovski article number); editing
    // stays admin-only. The photos themselves live in the render service's
    // own registry, not here — see Crystal_Fabric_Studio_Spec.md.
    match /crystal_swatch_notes/{colorId} {
      allow read: if isAdmin() || isApprovedCustomer();
      allow write: if isAdmin();
    }

    // Packaging inventory (V7.13a) — gift boxes / cartons / inserts, admin only.
    match /packaging/{packagingId} {
      allow read, write: if isAdmin();
      match /movements/{movementId} {
        allow read, write: if isAdmin();
      }
    }

    // B2C finished-goods stock (V7.21) — trading stock, unconnected to
    // production; same shape as crystals/packaging, admin only.
    match /b2c_stock/{b2cId} {
      allow read, write: if isAdmin();
      match /movements/{movementId} {
        allow read, write: if isAdmin();
      }
    }

    // ---- Shipping & Logistics module (admin only, except a customer's own
    // orders — portal order history, owner 2026-08-07) ---------------------
    match /orders/{orderId} {
      // profile().get('customer_id','') == '' for an unlinked customer login
      // — require it non-empty too, or that would match an order with an
      // equally-blank/malformed customer_id and leak it to any unlinked
      // customer account.
      allow read: if isAdmin()
        || (isApprovedCustomer()
            && profile().get('customer_id', '') != ''
            && resource.data.get('customer_id', '') == profile().get('customer_id', ''));
      allow write: if isAdmin();
      match /{allPaths=**} {
        allow read: if isAdmin()
          || (isApprovedCustomer()
              && profile().get('customer_id', '') != ''
              && get(/databases/$(database)/documents/orders/$(orderId)).data.get('customer_id', '') == profile().get('customer_id', ''));
        allow write: if isAdmin();
      }
    }
    match /packing_lists/{plId} {
      allow read, write: if isAdmin();
      match /{allPaths=**} {
        allow read, write: if isAdmin();
      }
    }
    match /logistics_vendors/{vendorId} {
      allow read, write: if isAdmin();
    }
    match /freight_quotes/{quoteId} {
      allow read, write: if isAdmin();
    }
    match /freight_rfqs/{rfqId} {
      allow read, write: if isAdmin();
    }

    // ---- UC# invoice registry (admin only) ------------------------------
    match /uc_invoices/{id} {
      allow read, write: if isAdmin();
    }
    // Atomic UC# allocation counter (counters/uc).
    match /counters/{name} {
      allow read, write: if isAdmin();
    }
  }
}
