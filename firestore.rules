rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return hasProfile() && profile().role == 'admin';
    }

    // ── V8.14 RBAC — flat staff role ─────────────────────────────────────
    // Every account is admin | staff | customer. A `staff` account's access
    // is EXACTLY the module keys in users/{uid}.modules[]. `can('<key>')`
    // is the check every collection below uses. Keep the key list + this
    // mapping in sync with src/access.js and RBAC-FLEX-PLAN.md §4.
    //
    // V8.14 flat model: a `staff` account's access is EXACTLY its modules[]
    // list; `can(key)` is the only gate. Mirror of src/access.js.
    function roleName() {
      return hasProfile() ? profile().role : '';
    }
    function moduleList() {
      return roleName() == 'staff'
        ? (profile().get('modules', []) is list ? profile().get('modules', []) : [])
        : [];
    }
    function can(m) {
      return isAdmin() || (hasProfile() && (m in moduleList()));
    }
    // Any internal login (used only where "one of our people" is enough).
    function isInternal() {
      return isAdmin() || roleName() == 'staff';
    }

    function isApprovedCustomer() {
      return hasProfile() && profile().role == 'customer' && profile().status == 'approved';
    }
    function canShop() {
      return isAdmin() || isApprovedCustomer();
    }
    // A customer flagged "sensitive" on their customers/ record must never be
    // shown a storefront product photo tagged "branded_for_customer_id" for a
    // DIFFERENT customer. get() inside a rule reads the target doc's raw data
    // regardless of its own read rule.
    function viewerIsSensitive() {
      return hasProfile()
        && profile().get('customer_id', '') != ''
        && exists(/databases/$(database)/documents/customers/$(profile().get('customer_id', '')))
        && get(/databases/$(database)/documents/customers/$(profile().get('customer_id', ''))).data.get('sensitive', false) == true;
    }

    match /users/{uid} {
      // `portal` module = view-only account roster (Portal → Login activity).
      // update/delete stay admin-only — a staff account can never change a
      // role/status or its own modules (no privilege escalation).
      allow read: if isAdmin() || can('portal') || request.auth.uid == uid;
      allow create: if request.auth.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.status == 'pending'
        && request.resource.data.ws_discount_pct == 0;
      // sensitive/erp_code/erp_code_shared are ADMIN-MIRRORED fields — a
      // customer must never set these on their own doc (they gate branded-photo
      // screening and the portal order-history data leak).
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.get('modules', []) == resource.data.get('modules', [])
            && request.resource.data.ws_discount_pct == resource.data.ws_discount_pct
            && request.resource.data.get('pricing_group', '') == resource.data.get('pricing_group', '')
            && request.resource.data.get('corp_markup_override', 0) == resource.data.get('corp_markup_override', 0)
            && request.resource.data.get('sensitive', false) == resource.data.get('sensitive', false)
            && request.resource.data.get('erp_code', '') == resource.data.get('erp_code', '')
            && request.resource.data.get('erp_code_shared', false) == resource.data.get('erp_code_shared', false));
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if canShop() || can('products') || can('quotes');
      allow write: if can('products');
      // Storefront photos — screened per-viewer (viewerIsSensitive). A
      // blank/unset branded_for is generic and always visible.
      match /images/{imageId} {
        allow read: if can('products') || can('quotes')
          || (isApprovedCustomer()
              && (resource.data.get('branded_for_customer_id', '') == ''
                  || resource.data.get('branded_for_customer_id', '') == profile().get('customer_id', '')
                  || !viewerIsSensitive()));
        allow write: if can('products');
      }
      // Tier prices — margin data. Read by quote-builders; the cost-derived
      // editor writes behind `pricing`.
      match /pricing_tiers/{tierId} {
        allow read: if canShop() || can('pricing') || can('quotes');
        allow write: if can('pricing');
      }
      match /customer_prices/{priceUid} {
        allow read: if request.auth.uid == priceUid || can('quotes') || can('customers');
        allow write: if can('pricing');
      }
      // Product bill-of-materials + supplier quotes — supply data.
      match /components/{componentId} {
        allow read, write: if can('supply');
        match /images/{imageId} {
          allow read, write: if can('supply');
        }
        match /supplier_quotes/{quoteId} {
          allow read, write: if can('supply');
          match /attachments/{attachmentId} {
            allow read, write: if can('supply');
          }
        }
      }
    }

    match /range_products/{rangeId} {
      allow read: if canShop() || can('figurine') || can('quotes');
      allow write: if can('figurine');
      match /{allPaths=**} {
        allow read: if canShop() || can('figurine') || can('quotes');
        allow write: if can('figurine');
      }
    }

    // V8.8 Phase 1 colour-preview drafts — top-level so the canShop() wildcard
    // above never grants a customer a read of an unreviewed draft.
    match /range_colour_previews/{previewId} {
      allow read, write: if isAdmin();
    }

    // `settings` mixes storefront config with internal cost data. Storefront
    // reads are allow-listed to the customer-facing docs only; the cost docs
    // (pricing_groups markup %, crystal_unit_costs) open to `pricing` / the
    // supply side; everything else is the `settings` module (sensitive).
    match /settings/{docId} {
      allow read: if isAdmin()
        || can('settings')
        || (canShop() && docId in [
          'catalogue_band', 'exchange_rates', 'format_moq',
          'front_page', 'productDefaults', 'quote_branding', 'crystal_colors',
        ])
        || (can('pricing') && docId in [
          'pricing_groups', 'crystal_unit_costs', 'format_moq',
          'component_categories', 'crystal_colors', 'exchange_rates',
        ])
        || (can('supply') && docId in [
          'format_moq', 'crystal_unit_costs', 'component_categories',
          'crystal_colors', 'exchange_rates',
        ]);
      allow write: if isAdmin()
        || (can('settings') && docId != 'pricing_groups')
        || (can('pricing') && docId in ['pricing_groups', 'crystal_unit_costs', 'component_categories'])
        || (can('supply') && docId in ['crystal_unit_costs', 'component_categories', 'crystal_colors', 'format_moq']);
    }

    match /favourites/{uid} {
      allow read, write: if request.auth.uid == uid || isAdmin();
    }

    match /enquiries/{eid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Customizer product templates — read for shoppers, admin writes.
    match /product_templates/{productId} {
      allow read: if canShop();
      allow write: if isAdmin();
    }

    // Customizer saved designs — a customer owns their own designs; admin sees all.
    match /customer_designs/{designId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Suppliers — supply-side.
    match /suppliers/{supplierId} {
      allow read, write: if can('supply');
      match /catalogs/{catalogId} {
        allow read, write: if can('supply');
      }
      match /images/{imageId} {
        allow read, write: if can('supply');
      }
      match /videos/{videoId} {
        allow read, write: if can('supply');
      }
    }
    match /client_quotes/{quoteId} {
      allow read, write: if can('quotes');
      match /items/{itemId} {
        allow read, write: if can('quotes');
      }
    }

    // Supplier purchase orders — procurement records, supply-side.
    match /purchase_orders/{poId} {
      allow read, write: if can('supply');
    }

    // Credit Notes — goods-return + accounting doc. The posted financial fact
    // lives in Postgres app_credit_note, reachable only via /api/credit-note.
    match /credit_notes/{cnId} {
      allow read, write: if can('credit_notes');
    }

    // SU-07A portal invitations — the claim/approve/resend/revoke logic runs
    // server-side (portal-invite.js, Admin SDK, bypasses rules). This rule
    // only blocks a browser from touching the collection directly.
    match /portal_invitations/{invitationId} {
      allow read: if isAdmin() || can('portal');
      allow write: if isAdmin();
    }

    // Append-only audit trail (AccountEdit.jsx logs role/status/modules
    // changes — the L-01 blind spot). Any internal login may append; only
    // admin reads it back; nothing edits or deletes an entry.
    match /audit_logs/{entryId} {
      allow create: if isInternal();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // Cached WooCommerce API pulls + the SEO control-plane stores. `woo` module.
    match /woo_cache/{doc} {
      allow read, write: if isAdmin() || can('woo');
    }
    match /seo_state/{doc} {
      allow read, write: if isAdmin() || can('woo');
    }
    match /seo_state_history/{doc} {
      allow read, create: if isAdmin() || can('woo');
      allow update, delete: if false;
      // Row chunks for a snapshot too large for one doc (created, never mutated).
      match /chunks/{c} {
        allow read, create: if isAdmin() || can('woo');
        allow update, delete: if false;
      }
    }
    match /seo_batches/{doc} {
      allow read, update: if isAdmin() || can('woo');
      allow create, delete: if false;
    }

    match /customers/{customerId} {
      allow read, write: if can('customers');
      match /enquiries/{enquiryId} {
        allow read, write: if can('customers');
      }
      match /email_threads/{threadId} {
        allow read, write: if can('customers');
      }
      match /whatsapp_threads/{threadId} {
        allow read, write: if can('customers');
      }
      match /alibaba_threads/{threadId} {
        allow read, write: if can('customers');
      }
      // Brand Gallery assets — a logged-in customer may read ONLY their own
      // linked customer's non-internal assets.
      match /assets/{assetId} {
        allow read: if can('customers')
          || (signedIn()
              && profile().get('customer_id', '') == customerId
              && resource.data.visibility != 'internal_only');
        allow write: if can('customers');
      }
      // Proposal — customer read scoped to their own linked customer AND
      // published only.
      match /proposal/{docId} {
        allow read: if can('customers')
          || (isApprovedCustomer()
              && profile().get('customer_id', '') != ''
              && profile().get('customer_id', '') == customerId
              && resource.data.status == 'published');
        allow write: if can('customers');
      }
    }

    // Marketing contacts (cleaned Mailchimp list + WP signups) — CRM data.
    // Public signups are written server-side by /api/subscribe.
    match /marketing_contacts/{contactId} {
      allow read, write: if can('customers');
      match /whatsapp_threads/{threadId} {
        allow read, write: if can('customers');
      }
      match /alibaba_threads/{threadId} {
        allow read, write: if can('customers');
      }
      match /email_threads/{threadId} {
        allow read, write: if can('customers');
      }
      match /enquiries/{enquiryId} {
        allow read, write: if can('customers');
      }
    }
    // Marketing campaigns / templates / Daily Drafts.
    match /marketing_campaigns/{campaignId} {
      allow read, write: if can('marketing');
    }
    match /campaign_templates/{templateId} {
      allow read, write: if can('marketing');
    }
    match /outreach_drafts/{draftId} {
      allow read, write: if can('marketing');
    }
    match /draft_memory_rules/{ruleId} {
      allow read, write: if can('marketing');
    }
    match /outreach_topic_templates/{templateId} {
      allow read, write: if can('marketing');
    }
    // Collection-group query over every customer's/lead's enquiries subcollection.
    match /{path=**}/enquiries/{enquiryId} {
      allow read: if can('customers');
    }
    // Collection-group query over supplier_quotes.
    match /{path=**}/supplier_quotes/{quoteId} {
      allow read, write: if can('supply');
    }
    match /catalogues/{catalogueId} {
      allow read, write: if can('catalogues');
      match /items/{itemId} {
        allow read, write: if can('catalogues');
      }
    }
    // Critical components master (metal parts) — supply-side.
    match /range_components/{componentId} {
      allow read, write: if can('supply');
      match /supplier_quotes/{quoteId} {
        allow read, write: if can('supply');
      }
      match /movements/{movementId} {
        allow read, write: if can('supply');
      }
    }

    // Crystal inventory + its append-only stock ledger — supply-side.
    match /crystals/{crystalId} {
      allow read, write: if can('supply');
      match /movements/{movementId} {
        allow read, write: if can('supply');
      }
    }

    // Crystal Fabric Studio swatch notes — read opened to approved portal
    // customers (designer matching an old Swarovski article no.) + the swatch
    // module; editing behind `swatch`.
    match /crystal_swatch_notes/{colorId} {
      allow read: if isAdmin() || can('swatch') || isApprovedCustomer();
      allow write: if isAdmin() || can('swatch');
    }

    // Packaging inventory — supply-side.
    match /packaging/{packagingId} {
      allow read, write: if can('supply');
      match /movements/{movementId} {
        allow read, write: if can('supply');
      }
    }

    // B2C finished-goods stock — trading stock, supply-side (an inventory
    // class on the Inventory + Components screens).
    match /b2c_stock/{b2cId} {
      allow read, write: if can('supply');
      match /movements/{movementId} {
        allow read, write: if can('supply');
      }
    }

    // ---- Shipping & Logistics — `shipping` module, except a customer's own
    // orders (portal order history) ------------------------------------------
    match /orders/{orderId} {
      allow read: if can('shipping')
        || (isApprovedCustomer()
            && profile().get('customer_id', '') != ''
            && resource.data.get('customer_id', '') == profile().get('customer_id', ''));
      allow write: if can('shipping');
      match /{allPaths=**} {
        allow read: if can('shipping')
          || (isApprovedCustomer()
              && profile().get('customer_id', '') != ''
              && get(/databases/$(database)/documents/orders/$(orderId)).data.get('customer_id', '') == profile().get('customer_id', ''));
        allow write: if can('shipping');
      }
    }
    match /packing_lists/{plId} {
      allow read, write: if can('shipping');
      match /{allPaths=**} {
        allow read, write: if can('shipping');
      }
    }
    match /logistics_vendors/{vendorId} {
      allow read, write: if can('shipping');
    }
    match /freight_quotes/{quoteId} {
      allow read, write: if can('shipping');
    }
    match /freight_rfqs/{rfqId} {
      allow read, write: if can('shipping');
    }

    // ---- UC# invoice registry — `uc` module ------------------------------
    match /uc_invoices/{id} {
      allow read, write: if can('uc');
    }
    // Atomic allocation counters (counters/uc_<yy>, so_<yy>, pu_<yy>).
    // Supply may touch ONLY pu_* (numbering a new PO); the UC/SO counters
    // belong to the quote flow.
    match /counters/{name} {
      allow read, write: if isAdmin()
        || (can('supply') && name.matches('pu_[0-9]+'))
        || (can('quotes') && name.matches('(uc|so)_[0-9]+'));
    }
  }
}
