rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All access requires a signed-in user
    function isAuth() {
      return request.auth != null;
    }

    // Products and all subcollections
    match /products/{productId} {
      allow read, write: if isAuth();

      match /images/{imageId} {
        allow read, write: if isAuth();
      }
      match /components/{componentId} {
        allow read, write: if isAuth();

        match /images/{imageId} {
          allow read, write: if isAuth();
        }
        match /supplier_quotes/{quoteId} {
          allow read, write: if isAuth();

          match /attachments/{attachmentId} {
            allow read, write: if isAuth();
          }
        }
      }
      match /pricing_tiers/{tierId} {
        allow read, write: if isAuth();
      }
    }

    // Suppliers and catalogs
    match /suppliers/{supplierId} {
      allow read, write: if isAuth();

      match /catalogs/{catalogId} {
        allow read, write: if isAuth();
      }
    }

    // Client quotes and items
    match /client_quotes/{quoteId} {
      allow read, write: if isAuth();

      match /items/{itemId} {
        allow read, write: if isAuth();
      }
    }

    // Customers and enquiry log
    match /customers/{customerId} {
      allow read, write: if isAuth();

      match /enquiries/{enquiryId} {
        allow read, write: if isAuth();
      }
    }

    // Collection group query for supplier_quotes (needed for supplier page)
    match /{path=**}/supplier_quotes/{quoteId} {
      allow read, write: if isAuth();
    }

    // Settings (exchange rates etc.)
    match /settings/{docId} {
      allow read, write: if isAuth();
    }

    // Catalogues and items
    match /catalogues/{catalogueId} {
      allow read, write: if isAuth();

      match /items/{itemId} {
        allow read, write: if isAuth();
      }
    }

    // Crystocraft Range — ready-to-ship figurine gifts
    match /range_products/{rangeId} {
      allow read, write: if isAuth();
    }

    // Critical Components library (shared parts for the figurine range)
    match /range_components/{componentId} {
      allow read, write: if isAuth();
    }
  }
}
