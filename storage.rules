rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // All access requires a signed-in user
    function isAuth() {
      return request.auth != null;
    }

    // Product images
    match /products/{productId}/{allPaths=**} {
      allow read, write: if isAuth();
    }

    // Component images
    match /components/{componentId}/{allPaths=**} {
      allow read, write: if isAuth();
    }

    // Supplier quote attachments
    match /supplier_quotes/{quoteId}/{allPaths=**} {
      allow read, write: if isAuth();
    }

    // Supplier catalogs
    match /suppliers/{supplierId}/{allPaths=**} {
      allow read, write: if isAuth();
    }

    // Catalogue cover images
    match /catalogues/{catalogueId}/{allPaths=**} {
      allow read, write: if isAuth();
    }

    // Customer enquiry attachments
    match /customers/{customerId}/{allPaths=**} {
      allow read, write: if isAuth();
    }

    // Customer Brand Gallery (V7.21) — uploaded to customer-assets/{customerId}/…
    // (customerAssets.js), a DIFFERENT top-level path from customers/{customerId}
    // above (that one is enquiry attachments). Was missing entirely — with no
    // matching rule, Storage's default-deny would have silently rejected every
    // Brand Gallery upload. The real access control is the Firestore doc's rule
    // (firestore.rules, admin-write / owner-read); this just needs to not block
    // the object write, same posture as the other admin-curated paths above.
    match /customer-assets/{customerId}/{allPaths=**} {
      allow read, write: if isAuth();
    }

    // Figurine Gifts (Crystocraft Range) images
    match /range_products/{rangeId}/{allPaths=**} {
      allow read, write: if isAuth();
    }

    // Critical Components library images
    match /range_components/{componentId}/{allPaths=**} {
      allow read, write: if isAuth();
    }

    // App-wide settings assets — quote stamp/signature, etc.
    match /settings/{allPaths=**} {
      allow read, write: if isAuth();
    }

    // Customizer — customer-uploaded logos + saved crystal render previews.
    // A user owns their own folder; anyone signed in may read (renders are shown
    // in enquiries/admin). Keyed by uid.
    match /customer_uploads/{uid}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if request.auth.uid == uid;
    }
    match /renders/{uid}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if request.auth.uid == uid;
    }

    // Shipping module — imported PI files (orders/imports/…) + freight quote
    // attachments. NOTE: reference copy — paste into the Storage Rules tab.
    match /orders/{orderId}/{allPaths=**} {
      allow read, write: if isAuth();
    }
    match /freight_quotes/{quoteId}/{allPaths=**} {
      allow read, write: if isAuth();
    }
  }
}
