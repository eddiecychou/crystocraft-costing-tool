rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // All access requires a signed-in user
    function isAuth() {
      return request.auth != null;
    }

    // Mirrors firestore.rules' isAdmin() — same users/{uid}.role=='admin' check,
    // via Storage's cross-service Firestore reference (firestore.get()/exists()).
    // V8.5 hardening: every path below used to be isAuth(), meaning a signed-in
    // CUSTOMER account (role:'customer') could read and write admin-only paths
    // (supplier quotes, settings assets, campaign images, etc.) — flagged during
    // the Supplier Workstation build, fixed here. Portal image display is
    // unaffected: customer pages only ever consume pre-resolved Firestore-stored
    // download-token URLs (getDownloadURL() output), which carry their own
    // access token and bypass these rules by design — they never call the
    // Storage SDK directly. customer_uploads/{uid} and renders/{uid} below stay
    // isAuth()/uid-owned — those ARE genuinely customer-facing (Customizer logo
    // upload + render preview).
    function isAdmin() {
      return isAuth() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Mirrors firestore.rules' isStaff() = admin OR the V8.12 `production`
    // role. Used on exactly the object paths whose Firestore records were
    // opened to isStaff() — supply-side catalogue/component/supplier assets.
    // Without this, a production user could edit a product/figurine/component/
    // supplier record but every file attach (gallery image, supplier catalog,
    // quote attachment) would be denied by Storage's default-deny. The
    // customer-facing customer_uploads/{uid} + renders/{uid} paths and every
    // admin-only domain path (customers, marketing, catalogues, settings
    // branding, orders, client_quotes) stay as they were.
    function isStaff() {
      return isAuth() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'production'];
    }

    // Product images + BOM-component images + BOM-component quote attachments
    // (all built under products/{id}/… — see SupplierQuoteForm.jsx). Firestore:
    // products + products/{id}/components + …/supplier_quotes are isStaff.
    match /products/{productId}/{allPaths=**} {
      allow read, write: if isStaff();
    }

    // Component images (legacy top-level path; current code writes component
    // images under products/{id}/… above). isStaff for parity with the
    // Firestore products/{id}/components grant.
    match /components/{componentId}/{allPaths=**} {
      allow read, write: if isStaff();
    }

    // Supplier quote attachments (legacy top-level path; parity with the
    // {path=**}/supplier_quotes collection-group rule, now isStaff).
    match /supplier_quotes/{quoteId}/{allPaths=**} {
      allow read, write: if isStaff();
    }

    // Supplier catalogs — Firestore suppliers is isStaff.
    match /suppliers/{supplierId}/{allPaths=**} {
      allow read, write: if isStaff();
    }

    // Catalogue cover images
    match /catalogues/{catalogueId}/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Customer enquiry attachments
    match /customers/{customerId}/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // WhatsApp "weak lead" attachments (V8.2) — marketing_contacts/{id}/whatsapp/…,
    // same idea as customers/{customerId}/whatsapp/… above but for a chat that
    // was saved as a lead rather than matched to a real customer.
    match /marketing_contacts/{contactId}/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Customer Brand Gallery (V7.21) — uploaded to customer-assets/{customerId}/…
    // (customerAssets.js), a DIFFERENT top-level path from customers/{customerId}
    // above (that one is enquiry attachments). Was missing entirely — with no
    // matching rule, Storage's default-deny would have silently rejected every
    // Brand Gallery upload. The real access control is the Firestore doc's rule
    // (firestore.rules, admin-write / owner-read); this just needs to not block
    // the object write, same posture as the other admin-curated paths above.
    match /customer-assets/{customerId}/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Figurine Gifts (Crystocraft Range) images — Firestore range_products is
    // isStaff (production has full figurine access incl. costing).
    match /range_products/{rangeId}/{allPaths=**} {
      allow read, write: if isStaff();
    }

    // Critical Components library images — Firestore range_components is isStaff.
    match /range_components/{componentId}/{allPaths=**} {
      allow read, write: if isStaff();
    }

    // App-wide settings assets — quote stamp/signature, etc.
    match /settings/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Customizer — customer-uploaded logos + saved crystal render previews.
    // A user owns their own folder; anyone signed in may read (renders are shown
    // in enquiries/admin). Keyed by uid.
    match /customer_uploads/{uid}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if request.auth.uid == uid;
    }
    match /renders/{uid}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if request.auth.uid == uid;
    }

    // Shipping module — imported PI files (orders/imports/…) + freight quote
    // attachments.
    match /orders/{orderId}/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /freight_quotes/{quoteId}/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Custom (non-catalogue) quote item images (V8.11, QuoteDetail.jsx's
    // "+ Custom Item") — path built as
    // client_quotes/custom_items/{itemId}/{Date.now()}.jpg. A custom item has
    // no product doc to file its image under products/{productId}/images, so
    // it gets its own path here — same idiom as campaign_images below, and
    // the same bug that comment describes (a missing rule here silently
    // rejects the upload with Storage's default-deny, not a helpful error).
    match /client_quotes/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Daily Drafts (V8.0) — images uploaded directly in the Compose phase
    // (not from a product's existing gallery — see DailyDrafts.jsx), same
    // idiom as campaign_images (Campaigns.jsx's Unlayer editor uploads).
    match /daily_draft_images/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Marketing campaign images (Campaigns.jsx's Unlayer editor uploads,
    // path built as campaign_images/{Date.now()}_{filename}). Was flagged in
    // the comment above but never actually added — with no matching rule,
    // Storage's default-deny silently rejected every campaign image upload
    // (bug-fix pack C-03). Same posture as every other admin-only path in
    // this file: real access control is app-level (only the Campaigns admin
    // page ever writes here), this just needs to not block the object write.
    match /campaign_images/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
