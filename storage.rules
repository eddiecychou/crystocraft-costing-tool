rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null && request.auth.uid != 'mcp-range-upload-service';
    }
    function pDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function pExists() {
      return isAuth() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return pExists() && pDoc().role == 'admin';
    }

    // ── V8.14 RBAC — flat staff role (mirrors firestore.rules) ────────────
    // access = users/{uid}.modules[]; `can(key)` is the only gate.
    function roleName() {
      return pExists() ? pDoc().role : '';
    }
    function moduleList() {
      return roleName() == 'staff'
        ? (pDoc().get('modules', []) is list ? pDoc().get('modules', []) : [])
        : [];
    }
    function can(m) {
      return isAdmin() || (pExists() && (m in moduleList()));
    }

    // Product photographs: immutable objects, current published revisions only.
    match /crystal-products/{pid}/{iid}/{revision}/{filename} {
      function image() { return firestore.get(/databases/(default)/documents/crystal_products/$(pid)/images/$(iid)).data; }
      function publishedPhoto() {
        let p=firestore.get(/databases/(default)/documents/crystal_products/$(pid)).data;
        let i=image();
        let path='crystal-products/'+pid+'/'+iid+'/'+revision+'/'+filename;
        return p.publication=='published' && i.publication=='published' && i.media!=null
          && path in [i.media.original,i.media.display,i.media.thumbnail];
      }
      allow get: if can('swatch') || (pExists() && pDoc().role=='customer' && pDoc().status=='approved' && publishedPhoto());
      allow create: if can('swatch') && resource==null
        && firestore.exists(/databases/(default)/documents/crystal_products/$(pid)/images/$(iid))
        && revision.matches('[a-f0-9]{64}') && filename.matches('(original[.](jpg|png|webp)|display[.]jpg|thumbnail[.]jpg)')
        && request.resource.size>0 && request.resource.size<=20971520
        && request.resource.contentType in ['image/jpeg','image/png','image/webp'];
      allow list, update, delete: if false;
    }
    // Drawings stay private to the submitting approved account and OC admin.
    match /enquiry-files/{uid}/{eid}/{file} {
      allow get: if isAdmin() || (pExists() && request.auth.uid==uid && pDoc().role=='customer' && pDoc().status=='approved');
      allow create: if resource==null && pExists() && request.auth.uid==uid && pDoc().role=='customer' && pDoc().status=='approved'
        && eid.matches('[A-Za-z0-9_-]{1,128}') && file.matches('[A-Za-z0-9_-]{1,128}[.](pdf|jpg|png|webp)')
        && request.resource.size>0 && request.resource.size<=20971520
        && request.resource.contentType in ['application/pdf','image/jpeg','image/png','image/webp'];
      allow list, update, delete: if false;
    }

    // Immutable swatch revisions. Read publication on every request, including
    // old revisions after replacement. Never expose migration extras/archives.
    match /crystal-swatches/{sampleId}/{revision}/{filename} {
      function sample() {
        return firestore.get(/databases/(default)/documents/crystal_swatches/$(sampleId)).data;
      }
      function sampleExists() {
        return firestore.exists(/databases/(default)/documents/crystal_swatches/$(sampleId));
      }
      function publishedImage() {
        let s = sample();
        let path = 'crystal-swatches/' + sampleId + '/' + revision + '/' + filename;
        return s.publication == 'published' && s.media != null
          && path in [s.media.original, s.media.display, s.media.thumbnail];
      }
      allow get: if can('swatch') || (pExists() && pDoc().role == 'customer'
        && pDoc().status == 'approved' && sampleExists() && publishedImage());
      allow create: if can('swatch') && sampleExists() && resource == null
        && sampleId.matches('sw_[a-zA-Z0-9_-]{16,80}') && revision.matches('[a-f0-9]{64}')
        && filename.matches('(original[.](jpg|png|webp)|display[.]jpg|thumbnail[.]jpg)')
        && request.resource.size > 0 && request.resource.size <= 20971520
        && request.resource.contentType in ['image/jpeg','image/png','image/webp'];
      allow list, update, delete: if false;
    }

    // Product images + BOM-component images + quote attachments (products/{id}/…).
    match /products/{productId}/{allPaths=**} {
      allow read, write: if can('products') || can('supply');
    }
    match /components/{componentId}/{allPaths=**} {
      allow read, write: if can('supply');
    }
    match /supplier_quotes/{quoteId}/{allPaths=**} {
      allow read, write: if can('supply');
    }
    match /suppliers/{supplierId}/{allPaths=**} {
      allow read, write: if can('supply');
    }
    // Visible-page and stitched full-listing screenshots from the
    // user-triggered 1688 extension.
    match /sourcing-captures/{uid}/{allPaths=**} {
      allow read: if can('supply');
      allow write: if can('supply') && (isAuth() && request.auth.uid == uid);
    }
    match /catalogues/{catalogueId}/{allPaths=**} {
      allow read, write: if can('catalogues');
    }
    match /customers/{customerId}/{allPaths=**} {
      allow read, write: if can('customers');
    }
    match /marketing_contacts/{contactId}/{allPaths=**} {
      allow read, write: if can('customers');
    }
    match /customer-assets/{customerId}/{allPaths=**} {
      allow read, write: if can('customers');
    }
    match /range_products/{rangeId}/{allPaths=**} {
      allow read, write: if can('figurine');
    }
    match /range_components/{componentId}/{allPaths=**} {
      allow read, write: if can('supply');
    }
    match /settings/{allPaths=**} {
      allow read, write: if isAdmin() || can('settings');
    }

    // Customizer — customer-owned folders, keyed by uid.
    // FIXED 2026-09-28 (whole-repo review): read was `if isAuth()` — ANY
    // signed-in account, including another pending/approved customer, could
    // read (Storage's read rule also covers list) every other customer's
    // uploaded logo and customised render. Scoped to the owner or an admin,
    // matching how the write rule was already scoped. See LESSONS-LEARNED.
    match /customer_uploads/{uid}/{allPaths=**} {
      allow read: if (isAuth() && request.auth.uid == uid) || isAdmin();
      allow write: if (isAuth() && request.auth.uid == uid);
    }
    match /renders/{uid}/{allPaths=**} {
      allow read: if (isAuth() && request.auth.uid == uid) || isAdmin();
      allow write: if (isAuth() && request.auth.uid == uid);
    }

    // Shipping — imported PI files + freight quote attachments.
    match /orders/{orderId}/{allPaths=**} {
      allow read, write: if can('shipping');
    }
    match /freight_quotes/{quoteId}/{allPaths=**} {
      allow read, write: if can('shipping');
    }
    // Custom quote item images.
    match /client_quotes/{allPaths=**} {
      allow read, write: if can('quotes');
    }
    // Daily Drafts + marketing campaign editor uploads.
    match /daily_draft_images/{allPaths=**} {
      allow read, write: if can('marketing');
    }
    match /campaign_images/{allPaths=**} {
      allow read, write: if can('marketing');
    }

    // Product Design (folded into this app under /design/* in V8.16 — was a
    // separate Next.js repo) — gated on the product_design module, pd_
    // prefixed to avoid colliding with the products/{id} path above (this
    // app's own catalogue images).
    match /pd_products/{productId}/{allPaths=**} {
      allow read, write: if can('product_design');
    }
    // Generation result images, keyed by templateId (not productId --
    // several templates for different customers share one product).
    match /pd_generations/{templateId}/{allPaths=**} {
      allow read, write: if can('product_design');
    }
    // Brand reference images (logos, marketing material) a customer's
    // brand profile was extracted from.
    match /pd_customer_brands/{customerId}/{allPaths=**} {
      allow read, write: if can('product_design');
    }
    // Scratch uploads for the Edit Template "extract elements from image"
    // flow — a reference photo passed to Gemini for analysis, not part of
    // any saved record. Same product_design posture as the rest of pd_*.
    match /pd_extraction_scratch/{templateId}/{allPaths=**} {
      allow read, write: if can('product_design');
    }
  }
}
