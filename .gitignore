node_modules
dist
.env.local
.env
.DS_Store
*.local

# Source / reference documents (keep locally, not in repo)
*.xlsx
*.xls
*.pdf

# Local Netlify folder
.netlify

# Firebase Admin service-account key — never commit.
# Second pattern catches the console's own download name, which is what
# actually lands in ~/Downloads and is easy to drop in unrenamed.
firebase-service-account.json
*firebase-adminsdk*.json
src/assets/fonts/NotoSansTC-Regular.ttf

# QA render artifacts (PDFs/PNGs produced by qa/pi-pagination.mjs)
qa/out/
# supplier-merge.test.mjs writes rewired module copies here; it self-cleans,
# this only matters if a run is killed mid-test.
qa/.smerge-*/

# Marketing / Mailchimp contact exports — personal data (emails, names),
# never commit. The Firestore `marketing_contacts` collection is the store;
# these local files are the one-time import source only.
migration/marketing_contacts/
*audience_export*.zip
*audience_export*.csv

# Legacy PHP B2B site — kept locally as build reference only, not useful
# now that the app exists, too large/stale for git.
LocalWeb/

# qa headless harness build artifacts — the *.mjs / *-preview.jsx sources are
# tracked; the generated bundle (.js/.css/.html) and screenshots are not.
# (gitignore has no brace expansion — one line per extension.)
qa/*-preview-seeded.js
qa/*-preview-seeded.css
qa/*-preview-seeded.html
qa/*-VXBWXKA3*
qa/*-????????.jpg
qa/*-????????.png
qa/*-before-*.png
qa/*-after-*.png
qa/*-before.png
qa/*-after.png
qa/*compare*.png
qa/*-empty.png
qa/*-desktop.png
qa/*-375.png

# design-system/ reference bundles: keep the TEXT (tokens, component specs,
# guidelines) in git; the logo/screenshot binaries are duplicates of
# src/assets/ and were tripping Netlify's secret scanner (a byte sequence in
# the JPEG data collides with an env-var value). Kept on disk, not tracked.
design-system/**/*.jpg
design-system/**/*.jpeg
design-system/**/*.png
design-system/**/*.webp
design-system/**/*.gif
design-system/**/.thumbnail

# Firebase emulator debug logs
firestore-debug.log
firebase-debug.log
ui-debug.log
*-debug.log
