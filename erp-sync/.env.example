# Copy this file to ".env" and fill in the blanks. NEVER commit the real .env.
# The .gitignore in this folder already excludes .env.

# Which source engine? "mssql" (Microsoft SQL Server) or "firebird".
# >>> CONFIRM THIS FIRST <<< A Delphi ERP (jes.exe) may be Firebird/Interbase,
# not MSSQL. Check services.msc on the DB VM and which port answers:
#   MSSQL = 1433 ,  Firebird/Interbase = 3050
SOURCE_ENGINE=mssql

# ── Microsoft SQL Server (used when SOURCE_ENGINE=mssql) ──────────────────────
MSSQL_HOST=192.168.10.251
MSSQL_PORT=1433
MSSQL_DB=CHANGE_ME_DB_NAME
MSSQL_USER=erp_readonly
MSSQL_PWD=
# If ODBC Driver 18 fails to connect to an older SQL Server, try Driver 17:
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# ── Firebird / Interbase (used when SOURCE_ENGINE=firebird) ───────────────────
# FB_HOST=192.168.10.251
# FB_PORT=3050
# FB_DATABASE=C:\path\to\erp.fdb      # server-side path to the database file
# FB_USER=SYSDBA
# FB_PWD=

# ── Supabase Postgres target ──────────────────────────────────────────────────
# Use the DIRECT / Session connection string (port 5432) from:
#   Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# NOT the anon/service API keys — the sync writes over a raw Postgres connection.
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
