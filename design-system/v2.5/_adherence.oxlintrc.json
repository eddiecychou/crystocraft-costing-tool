{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/display/**",
              "components/forms/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Questrial|Work Sans))/i]",
        "message": "Font not provided by the design system. Available: Questrial, Work Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|gifts|crystals|bespoke|solid-ink|solid-gold|platinum|new)$/]",
        "message": "<Badge> variant must be one of 'default' | 'gifts' | 'crystals' | 'bespoke' | 'solid-ink' | 'solid-gold' | 'platinum' | 'new'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md)$/]",
        "message": "<Badge> size must be one of 'xs' | 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|fullWidth|onClick|type|href|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, fullWidth, onClick, type, href, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|outline|outline-gold|reversed|sapphire|burgundy)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'outline' | 'outline-gold' | 'reversed' | 'sapphire' | 'burgundy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|padding|hoverable|radius|flat|borderless|className|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, variant, padding, hoverable, radius, flat, borderless, className, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|ivory|dark)$/]",
        "message": "<Card> variant must be one of 'default' | 'ivory' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg|xl)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:none|xs|sm|md)$/]",
        "message": "<Card> radius must be one of 'none' | 'xs' | 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CraftNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|variant|onDark|className|key|ref|className|style|children)$/]",
        "message": "<CraftNote> doesn't accept that prop. Declared props: label, children, variant, onDark, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='CraftNote'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gifts|crystals|bespoke)$/]",
        "message": "<CraftNote> variant must be one of 'gifts' | 'crystals' | 'bespoke'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|className|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: label, variant, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|gold|bold|subtle|on-dark)$/]",
        "message": "<Divider> variant must be one of 'default' | 'gold' | 'bold' | 'subtle' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FacetDivider'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|onDark|className|key|ref|className|style|children)$/]",
        "message": "<FacetDivider> doesn't accept that prop. Declared props: variant, onDark, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FacetDivider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gifts|crystals|bespoke)$/]",
        "message": "<FacetDivider> variant must be one of 'gifts' | 'crystals' | 'bespoke'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|defaultValue|onChange|type|error|hint|disabled|variant|id|name|required|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, value, defaultValue, onChange, type, error, hint, disabled, variant, id, name, required."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|password|number|tel|url|search)$/]",
        "message": "<Input> type must be one of 'text' | 'email' | 'password' | 'number' | 'tel' | 'url' | 'search'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:underline|boxed)$/]",
        "message": "<Input> variant must be one of 'underline' | 'boxed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|defaultValue|onChange|placeholder|error|disabled|variant|id|name|required|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, value, defaultValue, onChange, placeholder, error, disabled, variant, id, name, required."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:underline|boxed)$/]",
        "message": "<Select> variant must be one of 'underline' | 'boxed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|active|onClick|className|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, variant, active, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|filled|gold|sapphire|burgundy|dark)$/]",
        "message": "<Tag> variant must be one of 'default' | 'filled' | 'gold' | 'sapphire' | 'burgundy' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustSeal'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|color|showMark|markSrc|key|ref|className|style|children)$/]",
        "message": "<TrustSeal> doesn't accept that prop. Declared props: variant, size, color, showMark, markSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustSeal'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:authentication|origin|heritage|dazzle|smooth)$/]",
        "message": "<TrustSeal> variant must be one of 'authentication' | 'origin' | 'heritage' | 'dazzle' | 'smooth'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
